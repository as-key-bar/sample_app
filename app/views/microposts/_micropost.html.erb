<% display_post = micropost.plain_repost? ? micropost.reposted_micropost : micropost %>
<% if display_post %>
<% masked = logged_in? && current_user.masks_content_of?(display_post.user) %>
<li id="micropost-<%= micropost.id %>" class="micropost-card">
  <div>
    <%= link_to "", micropost_path(display_post), class: "card-link" =%>

    <% if micropost.plain_repost? %>
      <span class="repost-indicator">
        <%= link_to micropost.user.name, micropost.user, class: "inner-link" %> reposted
      </span>
    <% end %>

    <%= link_to gravatar_for(display_post.user, size: 50), display_post.user, class: "inner-link" %>
    <span class="user"><%= link_to display_post.user.name, display_post.user, class: "inner-link" %></span>

    <% if masked %>
      <%= render "microposts/masked_content" %>
    <% else %>
      <span class="content">
        <%= display_post.content %>
        <% if display_post.image.attached? %>
          <%= image_tag display_post.image.variant(:display) %>
        <% end %>
      </span>

      <% if !micropost.plain_repost? && micropost.reposted_micropost.present? %>
        <% quote_masked = logged_in? && current_user.masks_content_of?(micropost.reposted_micropost.user) %>
        <div class="quoted-micropost">
          <%= link_to "", micropost_path(micropost.reposted_micropost), class: "card-link" =%>
          <%= link_to gravatar_for(micropost.reposted_micropost.user, size: 30), micropost.reposted_micropost.user, class: "inner-link" %>
          <span class="user"><%= link_to micropost.reposted_micropost.user.name, micropost.reposted_micropost.user, class: "inner-link" %></span>
          <% if quote_masked %>
            <%= render "microposts/masked_content" %>
          <% else %>
            <span class="content"><%= micropost.reposted_micropost.content %></span>
          <% end %>
        </div>
      <% end %>
    <% end %>

    <span class="timestamp">
      Posted <%= time_ago_in_words(micropost.created_at) %> ago.
      <% if current_user?(micropost.user) %>
        <%= link_to "delete", micropost, data: { "turbo-method": :delete,
                                                turbo_confirm: "You sure?" },
                                          class: "inner-link" %>
      <% end %>
    </span>
    <% if logged_in? && !masked %>
      <span class="audience_action">
        <div id="favorite_form_<%= display_post.id %>">
          <% if current_user.favoriting?(display_post) %>
            <%= render "microposts/unfavorite", micropost: display_post %>
          <% else %>
            <%= render "microposts/favorite", micropost: display_post %>
          <% end %>
        </div>
        <div id="repost_form_<%= display_post.id %>">
          <% if current_user.plain_reposted?(display_post) %>
            <%= render "microposts/unrepost", micropost: display_post, repost: current_user.plain_repost_of(display_post) %>
          <% else %>
            <%= render "microposts/repost", micropost: display_post %>
          <% end %>
        </div>
        <details class="quote-repost">
          <summary class="btn btn-default">Quote</summary>
          <%= render "shared/micropost_form", object: current_user.microposts.build, reposted_micropost_id: display_post.id %>
        </details>
      </span>
    <% end %>
  </div>
</li>
<% end %>