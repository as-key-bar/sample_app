<% provide(:title, @micropost.content) %>

<div class="row">
  <div class="col-md-8 offset-md-2 micropost-thread-container">
    
    <% if @micropost.reply_to.present? %>
      <div class="thread-section parent-post">
        <span class="thread-label">Replying to</span>
        <%= render @micropost.reply_to %>
      </div>
    <% end %>

    <div class="thread-section main-post">
      <%= render @micropost %>
    </div>

    <% if logged_in? %>
      <section class="micropost_form reply-form-section">
        <%= render 'shared/micropost_form', object: @reply_micropost, reply_to_id: @micropost.id %>
      </section>
    <% end %>

    <% if @replies.any? %>
      <div class="thread-section replies-section">
        <h3 class="replies-heading">Replies (<%= @micropost.replies.count %>)</h3>
        <ol class="microposts replies-list">
          <%= render @replies %>
        </ol>
        <%= will_paginate @replies %>
      </div>
    <% end %>

  </div>
</div>