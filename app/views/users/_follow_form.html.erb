<% unless current_user?(@user) %>
  <div id="follow_form_<%= @user.id %>">
  <% if current_user.blocked?(@user) %>
    <%= render 'blocked_follow' %>
  <% elsif current_user.blocking?(@user) %>
    <%= render 'disabled_follow' %>
  <% elsif current_user.following?(@user) %>
    <%= render 'users_index_unfollow', user: @user %>
  <% else %>
    <%= render 'users_index_follow', user: @user %>
  <% end %>
  </div>
<% end %>
