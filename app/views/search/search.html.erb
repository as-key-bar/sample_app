<% provide(:title) { @title } %>
<div class="row">
  <h1>
    検索フォーム画面
  </h1>

  <%= form_with url:search_path, method: :get do |f| %>
    <%= f.label :q, "enter search query:" %>
    <%= f.search_field :q %>
    <%= f.submit "Search", name: nil %>
    <div>
        <%= f.label :follow_only do %>
          フォロー中のみ検索
          <%= f.check_box :follow_only, { checked: params[:follow_only] == "1" }, "1", nil %>
        <% end %>
    </div>

  <% end %>
</div>
